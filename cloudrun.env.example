# Copy this file to .env in the repository root. Never commit the completed .env file.
# scripts/deploy-cloud-run.ps1 reads it and puts private credentials in Secret Manager.

CLOUD_RUN_PROJECT_ID=your-google-cloud-project-id
CLOUD_RUN_REGION=asia-south1
CLOUD_RUN_SERVICE=canvas-web
CLOUD_RUN_MAX_INSTANCES=10
CLOUD_RUN_CONCURRENCY=40
CLOUD_RUN_MEMORY=1Gi

NEXT_PUBLIC_APP_URL=https://canvas.algoquit.com
NEXT_PUBLIC_APP_NAME=Canvas
NEXT_PUBLIC_COMPANY_NAME=AlgoQuit
NEXT_PUBLIC_COMPANY_URL=https://algoquit.com

MONGODB_URI=
MONGODB_DB_NAME=Canvas
REDIS_URL=
REDIS_TOKEN=
# Alternatively, set these two Upstash-compatible names and leave REDIS_URL/REDIS_TOKEN blank.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://canvas.algoquit.com/api/auth/google/callback
AUTH_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=

BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
BUNNY_STORAGE_ENDPOINT=https://storage.bunnycdn.com
BUNNY_VAULT_QUOTA_BYTES=5368709120
BUNNY_VAULT_MAX_FILE_BYTES=104857600

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

AXIOM_HOST=https://us-east-1.aws.edge.axiom.co
AXIOM_DATASET=
AXIOM_TOKEN=
AXIOM_SERVICE_NAME=canvas

# Optional monitoring and analytics; leave unused values blank.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_MIXPANEL_TOKEN=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
