# Conventus
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Conventus
NODE_ENV=development

# MongoDB
MONGODB_URI=
MONGODB_DB_NAME=Conventus

# Redis / Upstash REST
# Set REDIS_URL to your Upstash REST endpoint (https://...) and REDIS_TOKEN to its REST token.
# Native Redis URLs (rediss://...) are also supported when REDIS_TOKEN is omitted.
REDIS_URL=
REDIS_TOKEN=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Application security
AUTH_SECRET=
ENCRYPTION_KEY=

# Background jobs / delayed delivery
QSTASH_URL=
QSTASH_TOKEN=

# Email
RESEND_API_KEY=
EMAIL_FROM=

# Billing / Razorpay
# Use Razorpay Test Mode keys for local development and Live Mode keys only in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Conventus legal / invoice identity
# The website defaults to NEXT_PUBLIC_APP_URL when CONVENTUS_WEBSITE_URL is empty.
CONVENTUS_LEGAL_NAME=Conventus
CONVENTUS_WEBSITE_URL=
CONVENTUS_LOGO_URL=
CONVENTUS_BILLING_EMAIL=
CONVENTUS_PHONE=
CONVENTUS_TAX_ID=
CONVENTUS_GSTIN=
CONVENTUS_ADDRESS_LINE1=
CONVENTUS_ADDRESS_LINE2=
CONVENTUS_ADDRESS_CITY=
CONVENTUS_ADDRESS_STATE=
CONVENTUS_ADDRESS_POSTAL_CODE=
CONVENTUS_ADDRESS_COUNTRY=India

# Invoice tax treatment
CONVENTUS_GST_ENABLED=true
CONVENTUS_GST_RATE=18
CONVENTUS_GST_INCLUSIVE=true
CONVENTUS_SAC_CODE=

# Monitoring
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=