# Conventus
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Conventus
NODE_ENV=development

# MongoDB
MONGODB_URI=

# Redis Free — node-redis connection string, for example rediss://default:<password>@<host>:6379
# Do not paste an Upstash REST URL (https://...).
REDIS_URL=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Application security
AUTH_SECRET=
ENCRYPTION_KEY=

# Background jobs / delayed delivery
QSTASH_URL=
QSTASH_TOKEN=

# Realtime provider
REALTIME_URL=
REALTIME_TOKEN=

# Email
RESEND_API_KEY=
EMAIL_FROM=

# Billing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Monitoring
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=