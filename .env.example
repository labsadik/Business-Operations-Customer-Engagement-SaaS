# Public app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Canvas
NEXT_PUBLIC_COMPANY_NAME=AlgoQuit

# MongoDB
MONGODB_URI=
MONGODB_DB_NAME=canvas_test

# Redis / Upstash REST
REDIS_URL=
REDIS_TOKEN=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Application security
AUTH_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=

# Bunny.net Storage (server-only credentials)
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
BUNNY_STORAGE_ENDPOINT=https://storage.bunnycdn.com
BUNNY_VAULT_QUOTA_BYTES=5368709120
BUNNY_VAULT_MAX_FILE_BYTES=104857600

# Razorpay / platform billing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Canvas by AlgoQuit branding is bundled locally at /favicon.svg.


# Sentry (optional; DSNs are public identifiers, auth token is server/build-only)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Axiom observability (server-only)
AXIOM_HOST=
AXIOM_DATASET=
AXIOM_TOKEN=
AXIOM_SERVICE_NAME=canvas

# Browser analytics (public identifiers; safe to expose to the browser)
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_MIXPANEL_TOKEN=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
