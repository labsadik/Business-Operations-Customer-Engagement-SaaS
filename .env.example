# Conventus
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Conventus
NODE_ENV=development

# MongoDB
MONGODB_URI=

# Redis / Upstash REST
# Set REDIS_URL to your Upstash REST endpoint (https://...) and REDIS_TOKEN to its REST token.
# Native Redis URLs (rediss://...) are also supported when REDIS_TOKEN is omitted.
REDIS_URL=
REDIS_TOKEN=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Application security
AUTH_SECRET=
ENCRYPTION_KEY=

# Background jobs / delayed delivery
QSTASH_URL=
QSTASH_TOKEN=

# Realtime provider
REALTIME_URL=
REALTIME_TOKEN=

# Email
RESEND_API_KEY=
EMAIL_FROM=

# Billing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Monitoring
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=