{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "custom-worker.ts",
  "name": "test0001",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "conventus"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "images": {
    "binding": "IMAGES"
  }
}
