{
  "name": "conventus",
  "version": "0.1.0",
  "private": true,
  "description": "Conventus - real-time customer meeting scheduling for teams.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run build",
    "socket": "node server.mjs",
    "dev:realtime": "concurrently \"npm run dev\" \"npm run socket\""
  },
  "dependencies": {
    "lucide-react": "1.51.0",
    "mongoose": "9.10.3",
    "next": "16.3.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "redis": "6.3.0",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5.6",
    "tailwindcss": "4.3.1",
    "typescript": "^5.9.2"
  }
}
