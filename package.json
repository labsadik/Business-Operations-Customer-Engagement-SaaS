    "react-dom": "19.2.0",
    "redis": "6.3.0",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5.6",
    "tailwindcss": "4.3.1",
    "typescript": "^5.9.2"
  },
