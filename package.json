{
  "name": "conventus",
  "version": "0.1.0",
  "private": true,
  "description": "Conventus - real-time customer meeting scheduling for teams.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "next:build": "next build",
    "build:cloudflare": "npm run prepare:cloudflare && opennextjs-cloudflare build",
    "start": "next start",
    "preview": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "deploy": "npm run build:cloudflare && opennextjs-cloudflare deploy",
    "upload": "npm run build:cloudflare && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run build",
    "admin:create": "node scripts/create-platform-admin.mjs",
    "test": "node --experimental-strip-types --test tests/scheduling.test.ts tests/cookie-consent.test.ts tests/platform-communication.test.ts tests/feedback-flow.test.ts tests/support-tickets.test.ts tests/plan-management.test.ts",
    "prepare:cloudflare": "node scripts/prepare-cloudflare.mjs"
  },
  "dependencies": {
    "@axiomhq/js": "1.8.0",
    "@axiomhq/logging": "0.4.1",
    "@axiomhq/nextjs": "0.4.1",
    "@microsoft/clarity": "1.0.2",
    "@opennextjs/cloudflare": "1.20.8",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "lucide-react": "1.51.0",
    "mixpanel-browser": "2.83.0",
    "mongoose": "9.10.3",
    "next": "16.3.8",
    "pdf-lib": "1.17.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "redis": "6.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "eslint": "9.39.5",
    "postcss": "^8.5.6",
    "tailwindcss": "4.3.1",
    "typescript": "^5.9.2",
    "wrangler": "4.135.0",
    "eslint-config-next": "16.3.8"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
