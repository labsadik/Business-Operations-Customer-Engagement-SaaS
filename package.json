{
  "name": "canvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Canvas by AlgoQuit — company scheduling and collaboration workspace.",
  "scripts": {
    "dev": "node --experimental-strip-types server.mjs",
    "build": "next build",
    "start": "node --experimental-strip-types server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run build",
    "admin:create": "node scripts/create-platform-admin.mjs",
    "seed:demo": "node --experimental-strip-types scripts/seed-canvas-demo.mjs",
    "seed:smoke": "node --experimental-strip-types scripts/seed-canvas-scale-smoke.mjs",
    "test": "node --experimental-strip-types --test tests/scheduling.test.ts tests/cookie-consent.test.ts tests/platform-communication.test.ts tests/feedback-flow.test.ts tests/support-tickets.test.ts tests/plan-management.test.ts tests/task-management.test.ts tests/redis.test.ts tests/platform-announcement-client.test.ts tests/dashboard-loading-shell.test.ts tests/meeting-dashboard.test.ts tests/public-feedback-embed.test.ts tests/resource-guardrails.test.ts tests/live-chat.test.ts tests/sentry-config.test.ts",
    "roles:migrate": "node scripts/migrate-roles.mjs",
    "membership-profile:migrate": "node scripts/migrate-membership-profile-fields.mjs",
    "task-assignees:migrate": "node scripts/migrate-task-assignees.mjs",
    "audit-events:migrate": "node scripts/migrate-admin-audit-events.mjs",
    "brand:migrate": "node --experimental-strip-types scripts/migrate-brand-data.mjs"
  },
  "dependencies": {
    "@axiomhq/js": "1.8.0",
    "@axiomhq/logging": "0.4.1",
    "@axiomhq/nextjs": "0.4.1",
    "@microsoft/clarity": "1.0.2",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "lucide-react": "1.51.0",
    "mixpanel-browser": "2.83.0",
    "mongoose": "9.10.3",
    "next": "16.3.8",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "redis": "6.3.0",
    "@sentry/nextjs": "11.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "eslint": "9.39.5",
    "postcss": "^8.5.6",
    "tailwindcss": "4.3.1",
    "typescript": "^5.9.2",
    "eslint-config-next": "16.3.8"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
